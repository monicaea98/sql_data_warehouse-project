/*
==================================================================================
Quality Checks
==================================================================================
Script Purpose:
  This script performs various quality checks for data consistency, accurancy
  and standarization across the 'silver' schemas. It includes checks for:
  - Null or duplicated Primary keys.
  - Unwanted spaces in string fields.
  - Data standarization and consistency.
  - Invalid date ranges and orders
  - Data consistency between related fields.

Usage Notes:
  - Run these checks after data loading silver layer.
  - Investigate and resolve any discrepancies found during the checks.
==================================================================================
*/

-- =================================================================
-- Checking 'silver.crm_custom_info'
-- =================================================================

-- Check for NULLs or duplicates in Primary Key
-- Expectation: No Result

SELECT 
	cst_id,
	COUNT(*)
FROM silver.crm_custom_info
GROUP BY cst_id
HAVING COUNT(*) > 1 OR cst_id IS NULL

-- Check duplicates

SELECT
*
FROM(
	SELECT
		*,
		ROW_NUMBER() OVER (PARTITION BY cst_id ORDER BY cst_create_date DESC) AS flag_last
	FROM silver.crm_custom_info
)t WHERE flag_last != 1


-- Check for unwanted spaces
-- Expectation: No Result

SELECT cst_firstname
FROM silver.crm_custom_info
WHERE cst_firstname != TRIM(cst_firstname)

SELECT cst_lastname
FROM silver.crm_custom_info
WHERE cst_lastname != TRIM(cst_lastname)

SELECT cst_gndr
FROM silver.crm_custom_info
WHERE cst_gndr != TRIM(cst_gndr)

-- Data Standarization & consistency

SELECT DISTINCT cst_gndr
FROM silver.crm_custom_info

SELECT DISTINCT cst_marital_status
FROM silver.crm_custom_info

-- =================================================================
-- Checking 'silver.crm_prd_info'
-- =================================================================

-- Check for NULLs or duplicates in Primary Key
-- Expectation: No Result

SELECT 
	prd_id,
	COUNT(*)
FROM silver.crm_prd_info
GROUP BY prd_id
HAVING COUNT(*) > 1 OR prd_id IS NULL

-- Get cat_id
-- Check cat_id matches id in silver.erp_px_cat_g1v2

SELECT 
	prd_id,
	prd_key,
	REPLACE(SUBSTRING(prd_key, 1, 5), '-','_') AS cat_id,
	prd_nm,
	prd_cost,
	prd_line,
	prd_start_dt,
	prd_end_dt
FROM silver.crm_prd_info
WHERE REPLACE(SUBSTRING(prd_key, 1, 5), '-','_') NOT IN 
	(SELECT DISTINCT id FROM silver.erp_px_cat_g1v2)

-- Get prd_key
-- Check prd_key matches id in silver.crm_sales_details

SELECT 
	prd_id,
	prd_key,
	REPLACE(SUBSTRING(prd_key, 1, 5), '-','_') AS cat_id,
	SUBSTRING(prd_key, 7, LEN(prd_key)) AS prd_key,
	prd_nm,
	prd_cost,
	prd_line,
	prd_start_dt,
	prd_end_dt
FROM silver.crm_prd_info
WHERE SUBSTRING(prd_key, 7, LEN(prd_key)) IN 
	(SELECT DISTINCT sls_prd_key FROM silver.crm_sales_details)

